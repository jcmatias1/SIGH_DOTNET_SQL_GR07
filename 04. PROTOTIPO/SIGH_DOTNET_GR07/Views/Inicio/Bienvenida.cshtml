@* Pantalla intermedia tras un inicio de sesión correcto; redirige al menú principal *@
@model UsuarioSesion
@{
    Layout = null;
    ViewData["Titulo"] = "Bienvenido";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <partial name="_Head" />
    <meta http-equiv="refresh" content="2;url=@Url.Content("~/inicio")">
</head>
<body>
<div class="bienvenida">
    <div>
        <img src="~/img/logo-sigh.svg" alt="SIGH">
        <h1>Bienvenido, @Model?.NombreCompleto</h1>
        <p>Perfil: <strong>@Model?.PerfilesTexto</strong> · Último acceso: @Model?.UltimoAccesoTexto</p>
        <p class="mb-0">Cargando los módulos habilitados para su perfil...</p>
        <div class="barra-carga"><span></span></div>
        <p class="mt-3"><a class="text-white" href="~/inicio">Continuar <i class="bi bi-arrow-right"></i></a></p>
    </div>
</div>
</body>
</html>
